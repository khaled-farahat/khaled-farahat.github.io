---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

// read query params from the URL (support multiple `tag` params)
const url = new URL(Astro.request.url);
const tags = url.searchParams.getAll("tag").filter(Boolean);
const q = url.searchParams.get("q") ?? "";

const projects = await getCollection("work");
const posts = await getCollection("blog");

function matches(itemTitle: string, itemTags: string[] = []) {
  const lowerQ = q.trim().toLowerCase();
  const lowerTags = tags.map((t) => t.trim().toLowerCase()).filter(Boolean);

  // If tags selected, require that every selected tag appears in itemTags (AND)
  if (lowerTags.length > 0) {
    const itemLowerTags = itemTags.map((t) => t.toLowerCase());
    return lowerTags.every((lt) => itemLowerTags.includes(lt));
  }

  if (lowerQ) {
    return (
      itemTitle.toLowerCase().includes(lowerQ) ||
      itemTags.some((t) => t.toLowerCase().includes(lowerQ))
    );
  }

  // If no filters, include everything
  return true;
}

const filteredProjects = projects.filter((p) => matches(p.data.title, p.data.tags));
const filteredPosts = posts.filter((p) => matches(p.data.title, p.data.tags));

---

<Layout title="search">
  <PageHeader title="Search" bgText="search" />

  <div id="search-root" class="max-w-4xl m-auto mt-8 px-4" data-initial-tags={JSON.stringify(tags)}>
    <form id="searchForm" method="get" action="/search" class="mb-6">
      <div class="flex gap-2 items-center mb-2">
        <div id="tagChips" class="flex gap-2 flex-wrap"></div>
        <input
          id="tagInput"
          placeholder="Add tag and press Enter"
          class="px-3 py-1 rounded-lg bg-neutral-900/40 border border-amber-500/20 text-sm"
        />
      </div>

      <div class="flex gap-2">
        <input
          name="q"
          id="qInput"
          value={q}
          placeholder="Search projects and blogs..."
          class="flex-1 px-4 py-2 rounded-lg bg-neutral-900/40 border border-amber-500/20"
        />
        <button type="submit" class="px-4 py-2 rounded-lg bg-amber-500 text-black">Search</button>
      </div>

      <!-- hidden tag inputs will be injected here -->
      <div id="hiddenTags"></div>
    </form>

    {tags.length > 0 && (
      <p class="mb-4">Filtering by tags: {tags.map((t) => (
        <strong class="text-amber-400 mr-2">{t}</strong>
      ))}</p>
    )}

    <section class="mb-8">
      <h3 class="text-xl mb-4">Projects</h3>
      {filteredProjects.length === 0 ? (
        <p class="text-zinc-600">No projects found.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {filteredProjects.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      )}
    </section>

    <section>
      <h3 class="text-xl mb-4">Blogs</h3>
      {filteredPosts.length === 0 ? (
        <p class="text-zinc-600">No posts found.</p>
      ) : (
        <div class="grid grid-cols-1 gap-4">
          {filteredPosts.map((p) => (
            <a href={`/blogs/${p.slug}`} class="block p-4 rounded-lg border border-amber-500/20 hover:bg-amber-500/5">
              <h4 class="text-amber-400">{p.data.title}</h4>
              <div class="mt-2 flex gap-2 flex-wrap">
                {p.data.tags?.map((t) => (
                  <a href={`/search?tag=${encodeURIComponent(t)}`} class="text-xs px-2 py-0.5 rounded-full border border-amber-500/20 text-amber-400">{t}</a>
                ))}
              </div>
            </a>
          ))}
        </div>
      )}
    </section>
  </div>
</Layout>


<script>
  (function () {
    const root = document.getElementById('search-root');
    if (!root) return;
    let currentTags: string[] = [];
    try {
      const parsed = JSON.parse(root.dataset.initialTags || '[]');
      if (Array.isArray(parsed)) currentTags = parsed.filter((x) => typeof x === 'string');
    } catch (e) {
      currentTags = [];
    }

    // Fallback: if server didn't receive query params (empty tags), read from window.location
    // This handles cases where the URL was updated client-side (history.pushState) or
    // navigation happened without the server seeing the query string.
    if (currentTags.length === 0 && typeof window !== 'undefined') {
      try {
        const sp = new URL(window.location.href).searchParams;
        const clientTags = sp.getAll('tag').filter(Boolean);
        if (clientTags.length > 0) {
          currentTags = clientTags;
        }
      } catch (e) {
        // ignore
      }
    }

    const tagChips = document.getElementById("tagChips");
    const hiddenTags = document.getElementById("hiddenTags");
    const tagInputEl = document.getElementById("tagInput");
    const formEl = document.getElementById("searchForm");
    if (!tagChips || !hiddenTags || !tagInputEl || !formEl) return;

    const tagInput = tagInputEl as HTMLInputElement;
    const form = formEl as HTMLFormElement;
    const chipsRoot = tagChips as HTMLElement;
    const hiddenRoot = hiddenTags as HTMLElement;

    function renderChips() {
      chipsRoot.innerHTML = "";
      hiddenRoot.innerHTML = "";
      currentTags.forEach(function (t: string) {
        const chip = document.createElement("div");
        chip.className = "inline-flex items-center gap-2 px-2 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-sm";

        const label = document.createElement("span");
        label.textContent = t;
        chip.appendChild(label);

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "ml-2 text-xs text-amber-200 opacity-80 hover:opacity-100";
        btn.textContent = "×";
        btn.title = "Remove " + t;
        btn.addEventListener("click", function (e) {
          e.preventDefault();
          removeTag(t);
        });
        chip.appendChild(btn);

        chipsRoot.appendChild(chip);

        const hidden = document.createElement("input");
        hidden.type = "hidden";
        hidden.name = "tag";
        hidden.value = t;
        hiddenRoot.appendChild(hidden);
      });
    }

    function submitForm() {
      // form is typed as HTMLFormElement above; call submit()
      try {
        form.submit();
      } catch (e) {
        // fallback: trigger a submit event
        form.dispatchEvent(new Event('submit', { cancelable: true }));
      }
    }

    function addTag(raw: string) {
      const t = String(raw || "").trim();
      if (!t) return;
      const exists = currentTags.some(function (x) {
        return x.toLowerCase() === t.toLowerCase();
      });
      if (exists) return;
      currentTags.push(t);
      renderChips();
      submitForm();
    }

    function removeTag(tag: string) {
      currentTags = currentTags.filter(function (t) {
        return t.toLowerCase() !== tag.toLowerCase();
      });
      renderChips();
      submitForm();
    }

    renderChips();

    tagInput.addEventListener("keydown", function (e) {
      if (e.key === "Enter") {
        e.preventDefault();
        addTag(tagInput.value || "");
      }
    });
  })();
</script>

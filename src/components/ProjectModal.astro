---
import { Image } from "astro:assets";

interface Props {
  id: string;
  title: string;
  description: string;
  img?: string;
  imgAlt?: string;
  tags?: string[];
  link?: string;
  repo?: string;
  publishDate?: string | Date;
}

const { id, title, description, img, imgAlt, tags, link, repo, publishDate } =
  Astro.props as Props;

// Format date nicely
const formatDate = (date: string | Date) => {
  const d = new Date(date);
  return d.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
};
---

<dialog
  id={id}
  class="rounded-2xl p-0 bg-neutral-900 text-amber-50 max-w-2xl w-[92%] backdrop:bg-black/70 border border-zinc-800 max-h-[90vh] overflow-y-auto custom-scrollbar"
  role="dialog"
  aria-modal="true"
>
  <!-- Close button -->
  <button
    type="button"
    class="close-modal-btn absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full bg-zinc-800 hover:bg-zinc-700 text-zinc-400 hover:text-amber-400 transition-colors z-10"
    aria-label="Close dialog"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <div class="p-6">
    <!-- Title -->
    <h2 class="text-2xl font-bold mb-4 text-amber-400 pr-8">{title}</h2>

    <!-- Image with smart sizing -->
    {
      img && (
        <div
          class="mb-4 w-full rounded-lg overflow-hidden bg-zinc-800/50 flex items-center justify-center"
          style="min-height: 200px;"
        >
          <Image
            src={img}
            alt={imgAlt || title}
            width={800}
            height={450}
            class="w-full h-auto max-h-[400px] object-contain"
          />
        </div>
      )
    }

    <!-- Description -->
    <p class="mb-5 text-zinc-300 leading-relaxed">{description}</p>

    <!-- Tags -->
    {
      tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-5">
          {tags.map((t) => (
            <a
              href={`/search?q=${encodeURIComponent(t)}`}
              class="px-3 py-1 bg-zinc-800 rounded-full text-xs font-medium text-amber-400 hover:bg-amber-500/20 transition-colors"
              onclick="event.stopPropagation()"
            >
              {t}
            </a>
          ))}
        </div>
      )
    }

    <!-- Footer with links and date -->
    <div
      class="flex items-center justify-between pt-4 border-t border-zinc-800 flex-wrap gap-3"
    >
      <div class="flex gap-3">
        {
          repo && (
            <a
              href={repo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-zinc-800 hover:bg-zinc-700 rounded-lg text-sm font-medium text-amber-400 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
              GitHub
            </a>
          )
        }
        {
          link && (
            <a
              href={link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-amber-500 hover:bg-amber-600 rounded-lg text-sm font-medium text-neutral-900 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
              Live Demo
            </a>
          )
        }
      </div>

      {
        publishDate && (
          <time class="text-sm text-zinc-500" datetime={String(publishDate)}>
            {formatDate(publishDate)}
          </time>
        )
      }
    </div>
  </div>

  <style>
    /* Custom scrollbar styling */
    .custom-scrollbar::-webkit-scrollbar {
      width: 10px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
      background: #18181b;
      border-radius: 10px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #52525b;
      border-radius: 10px;
      border: 2px solid #18181b;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #f59e0b;
    }

    /* Firefox scrollbar */
    .custom-scrollbar {
      scrollbar-width: thin;
      scrollbar-color: #52525b #18181b;
    }
  </style>

  <script is:inline define:vars={{ id }}>
    (function () {
      // Wait for DOM to be fully loaded
      const initDialog = () => {
        const dialog = document.getElementById(id);
        if (!dialog) return;

        // Close button click
        const closeBtn = dialog.querySelector(".close-modal-btn");
        if (closeBtn) {
          closeBtn.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            dialog.close();
          });
        }

        // Close on backdrop click
        dialog.addEventListener("click", (e) => {
          if (e.target === dialog) {
            e.preventDefault();
            e.stopPropagation();
            dialog.close();
          }
        });

        // Close on Escape
        dialog.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            dialog.close();
          }
        });
      };

      // Initialize immediately if DOM is ready, otherwise wait
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initDialog);
      } else {
        initDialog();
      }
    })();
  </script>
</dialog>

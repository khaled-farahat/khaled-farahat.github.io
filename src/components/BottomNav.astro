<style>
  .navigation {
    width: 100%;
    height: 70px;
    background-color: #f5f5f5;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 10px;
    position: relative;
  }

  .navigation::after {
    content: "";
    position: absolute;
    top: -10px;
    left: 0;
    width: 100%;
    height: 10px;
    z-index: -10;
    background-color: #171717;
  }

  .navigation ul {
    display: flex;
    justify-content: space-around;
    /* align-items: center; */
    width: 90%;
  }

  .navigation ul li {
    position: relative;
    width: 18%;
    height: 70px;
    z-index: 1;
  }
  .navigation ul li a {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    width: 100%;
    text-align: center;
    font-weight: 500;
  }

  .navigation ul li a .icon {
    position: relative;
    display: block;
    line-height: 75px;
    font-size: 2em;
    text-align: center;
    /* transition: 0.5s; */ /* Commented out animation */
    margin: 20px 0;
    z-index: 10; /* Icon appears above the yellow indicator */
  }

  .navigation ul li.active a .icon {
    transform: translateY(-35px);
  }

  .navigation ul li a .text {
    position: absolute;
    font-weight: 400;
    font-size: 1em;
    letter-spacing: 0.05em;
    /* transition: 0.5s; */ /* Commented out animation */
    opacity: 0;
    font-weight: bold;
    transform: translateY(20px);
  }

  .navigation ul li.active a .text {
    opacity: 1;
    transform: translateY(10px);
  }

  /* CSS-only indicator - shows above active list item */
  .navigation ul li.active::before {
    content: "";
    position: absolute;
    top: -50%;
    left: 50%;
    transform: translateX(-50%);
    width: 70px;
    height: 70px;
    background-color: #fbbf24;
    border-radius: 50%;
    border: 6px solid rgb(23 23 23);
    z-index: 0; /* Behind the icon */
  }

  .navigation ul li.active::after {
    content: "";
    position: absolute;
    top: -15px;
    left: 50%;
    transform: translateX(-50%);
    width: 70px;
    height: 20px;
    background: transparent;
    z-index: 0;
  }

  /* Side shadows for the indicator */
  .navigation ul li.active .icon::before {
    content: "";
    position: absolute;
    top: -55px;
    left: -45px;
    width: 20px;
    height: 20px;
    background: transparent;
    border-top-right-radius: 20px;
    box-shadow: 1px -10px 0 0 rgb(23 23 23);
    z-index: 0; /* Behind the icon */
  }

  .navigation ul li.active .icon::after {
    content: "";
    position: absolute;
    top: -55px;
    right: -45px;
    width: 20px;
    height: 20px;
    background: transparent;
    border-top-left-radius: 20px;
    box-shadow: -1px -10px 0 0 rgb(23 23 23);
    z-index: 0; /* Behind the icon */
  }


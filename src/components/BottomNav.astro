---
import { Icon } from "astro-icon/components";

const pathname = new URL(Astro.request.url).pathname;
// Normalize path by removing leading and trailing slashes for consistent comparison
const currentPath = pathname.replace(/^\/|\/$/g, '');
---

<div class="navigation text-neutral-950">
  <ul>
    <li class=`list ${currentPath === '' && "active"}`>
      <a href="/">
        <span class="icon">
          <Icon name="IcRoundHome" />
        </span>
        <span class="text">Home</span>
      </a>
    </li>
    <li class=`list ${(currentPath === 'about' || currentPath.startsWith('about/')) && "active"}`>
      <a href="/about">
        <span class="icon">
          <Icon name="IcBaselinePerson" />
        </span>
        <span class="text">About</span>
      </a>
    </li>
    <li class=`list ${(currentPath === 'projects' || currentPath.startsWith('projects/')) && "active"}`>
      <a href="/projects">
        <span class="icon">
          <Icon name="IcBaselineCardTravel" />
        </span>
        <span class="text">Portfolio</span>
      </a>
    </li>
    <li class=`list ${(currentPath === 'contact' || currentPath.startsWith('contact/')) && "active"}`>
      <a href="/contact">
        <span class="icon">
          <Icon name="IcBaselineContactPage" />
        </span>
        <span class="text">Contact</span>
      </a>
    </li>
    <li class=`list ${(currentPath === 'blogs' || currentPath.startsWith('blogs/')) && "active"}`>
      <a href="/blogs">
        <span class="icon">
          <Icon name="IcBaselineWechat" />
        </span>
        <span class="text">Blogs</span>
      </a>
    </li>
    <!-- <div class="indicator"></div> -->
  </ul>
</div>

